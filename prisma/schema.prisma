generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  TECNICO
  ADMIN
}

enum TicketStatus {
  ABERTO
  EM_ANALISE
  EM_ATENDIMENTO
  AGUARDANDO_CLIENTE
  RESOLVIDO
  ENCERRADO
  CANCELADO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum HistoryAction {
  CRIACAO
  ALTERACAO
  MUDANCA_STATUS
  MUDANCA_PRIORIDADE
  TROCA_RESPONSAVEL
  UPLOAD_ARQUIVO
  EXCLUSAO
  COMENTARIO
  AVALIACAO
}

enum NotificationType {
  EMAIL
  INTERNA
}

model User {
  id                      String            @id @default(cuid())
  name                    String
  email                   String            @unique
  passwordHash            String
  role                    Role              @default(CLIENTE)
  avatarUrl               String?
  phone                   String?
  department              String?
  departmentId            String?
  departmentRel           Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive                Boolean           @default(true)
  clientProfile           Client?
  technician              Technician?
  assignedTickets         Ticket[]          @relation("AssignedTickets")
  requestedTickets        Ticket[]          @relation("RequestedTickets")
  requestedRemoteSessions RemoteSession[]   @relation("RequestedByRemoteSession")
  messages                TicketMessage[]
  histories               TicketHistory[]
  notifications           Notification[]
  ratings                 Rating[]          @relation("RatingAuthor")
  responsibleEquipment    Equipment[]       @relation("ResponsibleUserEquipment")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  remoteAccessLogs        RemoteAccessLog[]
}

model Client {
  id        String   @id @default(cuid())
  company   String?
  document  String?
  address   String?
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String?       @db.Text
  isActive      Boolean       @default(true)
  subCategories SubCategory[]
  tickets       Ticket[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SubCategory {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tickets    Ticket[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name, categoryId])
}

model SLA {
  id            String   @id @default(cuid())
  priority      Priority @unique
  responseHours Int
  solutionHours Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Ticket {
  id               String             @id @default(cuid())
  number           String             @unique
  title            String
  description      String             @db.Text
  priority         Priority           @default(MEDIA)
  status           TicketStatus       @default(ABERTO)
  tags             Json?
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  slaDueAt         DateTime
  responseDueAt    DateTime
  customerId       String
  customer         User               @relation("RequestedTickets", fields: [customerId], references: [id])
  assigneeId       String?
  assignee         User?              @relation("AssignedTickets", fields: [assigneeId], references: [id])
  categoryId       String
  category         Category           @relation(fields: [categoryId], references: [id])
  subCategoryId    String?
  subCategory      SubCategory?       @relation(fields: [subCategoryId], references: [id])
  equipmentId      String?
  equipment        Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  messages         TicketMessage[]
  attachments      TicketAttachment[]
  history          TicketHistory[]
  rating           Rating?
  remoteSessions   RemoteSession[]
  remoteAccessLogs RemoteAccessLog[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, priority])
  @@index([customerId])
  @@index([assigneeId])
  @@index([slaDueAt])
  @@index([equipmentId])
}

model TicketMessage {
  id          String             @id @default(cuid())
  ticketId    String
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User               @relation(fields: [authorId], references: [id])
  body        String             @db.Text
  isInternal  Boolean            @default(false)
  editedAt    DateTime?
  attachments TicketAttachment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model TicketAttachment {
  id        String         @id @default(cuid())
  ticketId  String
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId String?
  message   TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  fileName  String
  fileUrl   String         @db.Text
  fileType  String?
  fileSize  Int?
  createdAt DateTime       @default(now())
}

model Department {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?     @db.Text
  isActive    Boolean     @default(true)
  users       User[]
  equipment   Equipment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Technician {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone         String?
  certification Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Equipment {
  id                String            @id @default(cuid())
  patrimony         String?           @unique
  machineName       String
  hostname          String
  ipAddress         String
  currentUser       String?
  operatingSystem   String
  windowsVersion    String?
  processor         String?
  ramGb             Int?
  diskSpaceGb       Int?
  lastUpdateAt      DateTime?
  lastCommunication DateTime?
  isOnline          Boolean           @default(false)
  status            String?
  departmentId      String?
  department        Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  responsibleUserId String?
  responsibleUser   User?             @relation("ResponsibleUserEquipment", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  tickets           Ticket[]
  remoteSessions    RemoteSession[]
  remoteAccessLogs  RemoteAccessLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model RemoteSession {
  id             String    @id @default(cuid())
  equipmentId    String
  equipment      Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  ticketId       String?
  ticket         Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  requestedById  String?
  requestedBy    User?     @relation("RequestedByRemoteSession", fields: [requestedById], references: [id], onDelete: SetNull)
  sessionId      Int
  userName       String
  status         String    @default("PENDING")
  connectionType String
  mode           String
  startedAt      DateTime?
  endedAt        DateTime?
  isActive       Boolean   @default(true)
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model RemoteAccessLog {
  id              String    @id @default(cuid())
  technicianId    String
  technician      User      @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  ticketId        String?
  ticket          Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  sessionId       Int?
  mode            String
  action          String
  reason          String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationMinutes Int?
  audit           Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TicketHistory {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    HistoryAction
  fromValue String?
  toValue   String?
  metadata  Json?
  createdAt DateTime      @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INTERNA)
  title     String
  body      String           @db.Text
  readAt    DateTime?
  ticketId  String?
  createdAt DateTime         @default(now())
}

model Rating {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("RatingAuthor", fields: [authorId], references: [id])
  score     Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
}
